# Copy to .env and fill in only the providers you have. Everything is optional:
# the default pipeline runs on keyless public sources.

# FRED / ALFRED (https://fred.stlouisfed.org/docs/api/api_key.html) - enables real-time vintages
FRED_API_KEY=
# BLS public API v2 key (raises daily query limit from 25 to 500)
BLS_API_KEY=
# Optional override of the data/artifact roots
MARKETPRED_DATA_DIR=
MARKETPRED_ARTIFACTS_DIR=
# Optional log level (DEBUG, INFO, WARNING)
MARKETPRED_LOG_LEVEL=INFO
